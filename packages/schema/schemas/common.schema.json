{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qualis:schema:common:1",
  "title": "Qualis shared definitions",
  "$defs": {
    "IssueType": {
      "enum": [
        "bug",
        "vulnerability",
        "security-hotspot",
        "code-smell"
      ]
    },
    "Characteristic": {
      "enum": [
        "reliability",
        "security",
        "maintainability"
      ]
    },
    "Severity": {
      "enum": [
        "blocker",
        "critical",
        "major",
        "minor",
        "info"
      ]
    },
    "Rating": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "PositiveInt": {
      "type": "integer",
      "minimum": 1
    },
    "NonNegativeInt": {
      "type": "integer",
      "minimum": 0
    },
    "Percent": {
      "type": "number",
      "minimum": 0
    },
    "TextRange": {
      "description": "1-based lines and columns; columns in UTF-16 code units; endColumn exclusive.",
      "type": "object",
      "required": [
        "startLine",
        "startColumn",
        "endLine",
        "endColumn"
      ],
      "additionalProperties": false,
      "properties": {
        "startLine": {
          "$ref": "#/$defs/PositiveInt"
        },
        "startColumn": {
          "$ref": "#/$defs/PositiveInt"
        },
        "endLine": {
          "$ref": "#/$defs/PositiveInt"
        },
        "endColumn": {
          "$ref": "#/$defs/PositiveInt"
        }
      }
    },
    "SecondaryLocation": {
      "type": "object",
      "required": [
        "range"
      ],
      "additionalProperties": false,
      "properties": {
        "range": {
          "$ref": "#/$defs/TextRange"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "Reference": {
      "type": "object",
      "required": [
        "publisher",
        "title",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "RuleParameter": {
      "type": "object",
      "required": [
        "name",
        "description",
        "type",
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": [
            "integer",
            "number",
            "string",
            "boolean"
          ]
        },
        "default": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        }
      }
    },
    "RuleDefinition": {
      "type": "object",
      "required": [
        "id",
        "name",
        "languages",
        "type",
        "severity",
        "tags",
        "enabledByDefault",
        "effortMinutes",
        "description",
        "rationale",
        "references"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "type": {
          "$ref": "#/$defs/IssueType"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabledByDefault": {
          "type": "boolean"
        },
        "effortMinutes": {
          "type": "number",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "exceptions": {
          "type": "string"
        },
        "noncompliantExample": {
          "type": "string"
        },
        "compliantExample": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleParameter"
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
          }
        },
        "scope": {
          "$ref": "#/$defs/RuleScope",
          "description": "Default code the rule applies to. When absent: `all` for bugs, `main` for the other types."
        }
      }
    },
    "LanguageDescriptor": {
      "type": "object",
      "required": [
        "id",
        "name",
        "extensions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+#.-]*$"
        },
        "name": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9.+-]+$"
          }
        }
      }
    },
    "IssueCounts": {
      "type": "object",
      "required": [
        "total",
        "blocker",
        "critical",
        "major",
        "minor",
        "info",
        "bugs",
        "vulnerabilities",
        "securityHotspots",
        "codeSmells"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "blocker": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "critical": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "major": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "minor": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "info": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "bugs": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "vulnerabilities": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "codeSmells": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "securityHotspots": {
          "$ref": "#/$defs/NonNegativeInt"
        }
      }
    },
    "Ratings": {
      "type": "object",
      "required": [
        "reliability",
        "security",
        "maintainability"
      ],
      "additionalProperties": false,
      "properties": {
        "reliability": {
          "$ref": "#/$defs/Rating"
        },
        "security": {
          "$ref": "#/$defs/Rating"
        },
        "maintainability": {
          "$ref": "#/$defs/Rating"
        }
      }
    },
    "CoverageMeasures": {
      "type": "object",
      "required": [
        "linesToCover",
        "coveredLines",
        "uncoveredLines",
        "conditionsToCover",
        "coveredConditions",
        "uncoveredConditions",
        "lineCoverage",
        "branchCoverage",
        "coverage"
      ],
      "additionalProperties": false,
      "properties": {
        "linesToCover": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "coveredLines": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "uncoveredLines": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "conditionsToCover": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "coveredConditions": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "uncoveredConditions": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "lineCoverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "branchCoverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "GateMetric": {
      "enum": [
        "reliabilityRating",
        "securityRating",
        "maintainabilityRating",
        "issues",
        "blockerIssues",
        "criticalIssues",
        "majorIssues",
        "bugs",
        "vulnerabilities",
        "securityHotspots",
        "codeSmells",
        "technicalDebtMinutes",
        "debtRatio",
        "coverage",
        "lineCoverage",
        "branchCoverage",
        "duplicatedLinesDensity",
        "testFailures",
        "testSuccessDensity"
      ]
    },
    "GateCondition": {
      "type": "object",
      "required": [
        "metric",
        "operator",
        "threshold"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "$ref": "#/$defs/GateMetric"
        },
        "scope": {
          "enum": [
            "overall",
            "new"
          ]
        },
        "operator": {
          "enum": [
            "gt",
            "lt"
          ]
        },
        "threshold": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/Rating"
            }
          ]
        }
      }
    },
    "HalsteadCounts": {
      "type": "object",
      "required": [
        "distinctOperators",
        "distinctOperands",
        "totalOperators",
        "totalOperands"
      ],
      "additionalProperties": false,
      "properties": {
        "distinctOperators": {
          "type": "integer",
          "minimum": 0
        },
        "distinctOperands": {
          "type": "integer",
          "minimum": 0
        },
        "totalOperators": {
          "type": "integer",
          "minimum": 0
        },
        "totalOperands": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "HalsteadMeasures": {
      "type": "object",
      "required": [
        "distinctOperators",
        "distinctOperands",
        "totalOperators",
        "totalOperands",
        "vocabulary",
        "length",
        "volume",
        "difficulty",
        "effort",
        "timeSeconds",
        "deliveredBugs"
      ],
      "properties": {
        "distinctOperators": {
          "type": "integer",
          "minimum": 0
        },
        "distinctOperands": {
          "type": "integer",
          "minimum": 0
        },
        "totalOperators": {
          "type": "integer",
          "minimum": 0
        },
        "totalOperands": {
          "type": "integer",
          "minimum": 0
        },
        "vocabulary": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "difficulty": {
          "type": "number",
          "minimum": 0
        },
        "effort": {
          "type": "number",
          "minimum": 0
        },
        "timeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "deliveredBugs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "FunctionMetrics": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "range",
        "ncloc",
        "parameters",
        "complexity",
        "cognitiveComplexity",
        "maxNestingDepth"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "function",
            "method",
            "constructor",
            "accessor",
            "lambda",
            "local-function"
          ]
        },
        "range": {
          "$ref": "#/$defs/TextRange"
        },
        "ncloc": {
          "type": "integer",
          "minimum": 0
        },
        "parameters": {
          "type": "integer",
          "minimum": 0
        },
        "complexity": {
          "type": "integer",
          "minimum": 0
        },
        "cognitiveComplexity": {
          "type": "integer",
          "minimum": 0
        },
        "maxNestingDepth": {
          "type": "integer",
          "minimum": 0
        },
        "halstead": {
          "$ref": "#/$defs/HalsteadCounts"
        }
      }
    },
    "FunctionReport": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "range",
        "ncloc",
        "parameters",
        "complexity",
        "cognitiveComplexity",
        "maxNestingDepth",
        "halstead",
        "maintainabilityIndex"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "function",
            "method",
            "constructor",
            "accessor",
            "lambda",
            "local-function"
          ]
        },
        "range": {
          "$ref": "#/$defs/TextRange"
        },
        "ncloc": {
          "type": "integer",
          "minimum": 0
        },
        "parameters": {
          "type": "integer",
          "minimum": 0
        },
        "complexity": {
          "type": "integer",
          "minimum": 0
        },
        "cognitiveComplexity": {
          "type": "integer",
          "minimum": 0
        },
        "maxNestingDepth": {
          "type": "integer",
          "minimum": 0
        },
        "halstead": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/HalsteadMeasures"
            }
          ]
        },
        "maintainabilityIndex": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "PluginKind": {
      "enum": [
        "language",
        "rule-pack"
      ]
    },
    "RuleScope": {
      "enum": [
        "main",
        "test",
        "all"
      ],
      "description": "Code a rule applies to: `main` (production code), `test` (test code) or `all`."
    },
    "ExternalRule": {
      "type": "object",
      "description": "A rule of another tool whose issues were imported from a report (`externalIssues`).",
      "required": [
        "id",
        "name",
        "languages",
        "type",
        "severity",
        "tags",
        "enabledByDefault",
        "effortMinutes",
        "description",
        "rationale",
        "references",
        "plugin",
        "defaultSeverity",
        "paramValues",
        "external"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^external:[a-z0-9][a-z0-9._-]*:.+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "$ref": "#/$defs/IssueType"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabledByDefault": {
          "type": "boolean"
        },
        "effortMinutes": {
          "type": "number",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "plugin": {
          "const": "external"
        },
        "defaultSeverity": {
          "$ref": "#/$defs/Severity"
        },
        "paramValues": {
          "type": "object",
          "maxProperties": 0
        },
        "scope": {
          "$ref": "#/$defs/RuleScope"
        },
        "external": {
          "type": "object",
          "required": [
            "tool",
            "ruleId"
          ],
          "additionalProperties": false,
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1,
              "description": "Name of the tool as written in the report, e.g. ESLint."
            },
            "ruleId": {
              "type": "string",
              "minLength": 1,
              "description": "Rule id in the tool, e.g. react-hooks/exhaustive-deps."
            },
            "helpUri": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
