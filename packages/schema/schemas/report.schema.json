{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qualis:schema:report:1",
  "title": "Qualis analysis report",
  "description": "Complete result of one analysis. All paths are relative to the project root and use forward slashes.",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "project",
    "analysis",
    "qualityGate",
    "measures",
    "files",
    "issues",
    "rules",
    "duplications",
    "tests",
    "coverageReports",
    "diagnostics"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version",
        "plugins"
      ],
      "properties": {
        "name": {
          "const": "qualis"
        },
        "version": {
          "type": "string"
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "version",
              "apiVersion",
              "transport",
              "languages",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "apiVersion": {
                "type": "integer"
              },
              "transport": {
                "enum": [
                  "module",
                  "process"
                ]
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "$ref": "urn:qualis:schema:common:1#/$defs/PluginKind"
              }
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "key",
        "name"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "id",
        "startedAt",
        "finishedAt",
        "durationMs",
        "vcs",
        "newCode"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "vcs": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "type",
                "revision",
                "branch",
                "dirty"
              ],
              "properties": {
                "type": {
                  "const": "git"
                },
                "revision": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "branch": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dirty": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "newCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "reference",
                "baseRevision"
              ],
              "properties": {
                "reference": {
                  "type": "string"
                },
                "baseRevision": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "qualityGate": {
      "type": "object",
      "required": [
        "name",
        "status",
        "conditions"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "metric",
              "scope",
              "operator",
              "threshold",
              "actual",
              "status"
            ],
            "properties": {
              "metric": {
                "$ref": "urn:qualis:schema:common:1#/$defs/GateMetric"
              },
              "scope": {
                "enum": [
                  "overall",
                  "new"
                ]
              },
              "operator": {
                "enum": [
                  "gt",
                  "lt"
                ]
              },
              "threshold": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "$ref": "urn:qualis:schema:common:1#/$defs/Rating"
                  }
                ]
              },
              "actual": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "urn:qualis:schema:common:1#/$defs/Rating"
                  }
                ]
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "no-data"
                ]
              }
            }
          }
        }
      }
    },
    "measures": {
      "type": "object",
      "required": [
        "overall",
        "newCode"
      ],
      "properties": {
        "overall": {
          "$ref": "#/$defs/OverallMeasures"
        },
        "newCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/NewCodeMeasures"
            }
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileReport"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Issue"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "if": {
          "type": "object",
          "required": [
            "plugin"
          ],
          "properties": {
            "plugin": {
              "const": "external"
            }
          }
        },
        "then": {
          "$ref": "urn:qualis:schema:common:1#/$defs/ExternalRule"
        },
        "else": {
          "allOf": [
            {
              "$ref": "urn:qualis:schema:common:1#/$defs/RuleDefinition"
            },
            {
              "type": "object",
              "required": [
                "plugin",
                "defaultSeverity",
                "paramValues"
              ],
              "properties": {
                "plugin": {
                  "type": "string"
                },
                "defaultSeverity": {
                  "$ref": "urn:qualis:schema:common:1#/$defs/Severity"
                },
                "paramValues": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "number",
                      "string",
                      "boolean"
                    ]
                  }
                },
                "scope": {
                  "$ref": "urn:qualis:schema:common:1#/$defs/RuleScope",
                  "description": "Effective scope of the rule in this analysis."
                }
              }
            }
          ]
        }
      }
    },
    "duplications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tokens",
          "occurrences"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "minimum": 1
          },
          "occurrences": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "path",
                "startLine",
                "endLine"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "tests": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "reports",
            "suites"
          ],
          "properties": {
            "reports": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "suites": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "report",
                  "tests",
                  "failed",
                  "errors",
                  "skipped",
                  "durationMs",
                  "cases"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "report": {
                    "type": "string"
                  },
                  "tests": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "errors": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "skipped": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "durationMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cases": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "status",
                        "durationMs"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "className": {
                          "type": "string"
                        },
                        "status": {
                          "enum": [
                            "passed",
                            "failed",
                            "error",
                            "skipped"
                          ]
                        },
                        "durationMs": {
                          "type": "number",
                          "minimum": 0
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "coverageReports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "externalIssueReports": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "External issue reports that were imported (`externalIssues.reports`)."
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level",
          "source",
          "message"
        ],
        "properties": {
          "level": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "source": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "DuplicationMeasures": {
      "type": "object",
      "required": [
        "duplicatedLines",
        "duplicatedBlocks",
        "duplicatedFiles",
        "duplicatedLinesDensity"
      ],
      "properties": {
        "duplicatedLines": {
          "type": "integer",
          "minimum": 0
        },
        "duplicatedBlocks": {
          "type": "integer",
          "minimum": 0
        },
        "duplicatedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "duplicatedLinesDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "TestMeasures": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed",
        "errors",
        "skipped",
        "durationMs",
        "successDensity"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "successDensity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "OverallMeasures": {
      "type": "object",
      "required": [
        "files",
        "lines",
        "ncloc",
        "commentLines",
        "commentLinesDensity",
        "functions",
        "classes",
        "statements",
        "complexity",
        "cognitiveComplexity",
        "issues",
        "ratings",
        "technicalDebtMinutes",
        "debtRatio",
        "duplication",
        "coverage",
        "tests",
        "complexityDensity",
        "functionStats",
        "halstead",
        "hotspots"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "ncloc": {
          "type": "integer",
          "minimum": 0
        },
        "commentLines": {
          "type": "integer",
          "minimum": 0
        },
        "commentLinesDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "functions": {
          "type": "integer",
          "minimum": 0
        },
        "classes": {
          "type": "integer",
          "minimum": 0
        },
        "statements": {
          "type": "integer",
          "minimum": 0
        },
        "complexity": {
          "type": "integer",
          "minimum": 0
        },
        "cognitiveComplexity": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "$ref": "urn:qualis:schema:common:1#/$defs/IssueCounts"
        },
        "ratings": {
          "$ref": "urn:qualis:schema:common:1#/$defs/Ratings"
        },
        "technicalDebtMinutes": {
          "type": "number",
          "minimum": 0
        },
        "debtRatio": {
          "type": "number",
          "minimum": 0
        },
        "duplication": {
          "$ref": "#/$defs/DuplicationMeasures"
        },
        "coverage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:qualis:schema:common:1#/$defs/CoverageMeasures"
            }
          ]
        },
        "tests": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/TestMeasures"
            }
          ]
        },
        "complexityDensity": {
          "type": "number",
          "minimum": 0
        },
        "hotspots": {
          "type": "object",
          "required": [
            "complexity",
            "cognitiveComplexity",
            "maintainabilityIndex"
          ],
          "properties": {
            "complexity": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "name",
                  "startLine",
                  "value"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "startLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "value": {
                    "type": "number"
                  }
                }
              }
            },
            "cognitiveComplexity": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "name",
                  "startLine",
                  "value"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "startLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "value": {
                    "type": "number"
                  }
                }
              }
            },
            "maintainabilityIndex": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "name",
                  "startLine",
                  "value"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "startLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "value": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "halstead": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "volume",
                "effort",
                "deliveredBugs"
              ],
              "properties": {
                "volume": {
                  "type": "number",
                  "minimum": 0
                },
                "effort": {
                  "type": "number",
                  "minimum": 0
                },
                "deliveredBugs": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "functionStats": {
          "type": "object",
          "required": [
            "count",
            "averageComplexity",
            "maxComplexity",
            "averageCognitiveComplexity",
            "maxCognitiveComplexity",
            "averageNcloc",
            "averageParameters",
            "maxNestingDepth",
            "complexityDistribution",
            "averageMaintainabilityIndex",
            "minMaintainabilityIndex",
            "maintainabilityDistribution"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "averageComplexity": {
              "type": "number",
              "minimum": 0
            },
            "maxComplexity": {
              "type": "integer",
              "minimum": 0
            },
            "averageCognitiveComplexity": {
              "type": "number",
              "minimum": 0
            },
            "maxCognitiveComplexity": {
              "type": "integer",
              "minimum": 0
            },
            "averageNcloc": {
              "type": "number",
              "minimum": 0
            },
            "averageParameters": {
              "type": "number",
              "minimum": 0
            },
            "maxNestingDepth": {
              "type": "integer",
              "minimum": 0
            },
            "complexityDistribution": {
              "type": "object",
              "required": [
                "low",
                "moderate",
                "high",
                "veryHigh"
              ],
              "properties": {
                "low": {
                  "type": "integer",
                  "minimum": 0
                },
                "moderate": {
                  "type": "integer",
                  "minimum": 0
                },
                "high": {
                  "type": "integer",
                  "minimum": 0
                },
                "veryHigh": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "averageMaintainabilityIndex": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "minMaintainabilityIndex": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "maintainabilityDistribution": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "high",
                    "moderate",
                    "low"
                  ],
                  "properties": {
                    "high": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "moderate": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "low": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            }
          }
        },
        "testCode": {
          "type": "object",
          "required": [
            "files",
            "lines",
            "ncloc"
          ],
          "additionalProperties": false,
          "description": "Size of the test code, which the other measures leave out.",
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "lines": {
              "type": "integer",
              "minimum": 0
            },
            "ncloc": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "NewCodeMeasures": {
      "type": "object",
      "required": [
        "lines",
        "ncloc",
        "issues",
        "ratings",
        "technicalDebtMinutes",
        "debtRatio",
        "duplicatedLines",
        "duplicatedLinesDensity",
        "coverage"
      ],
      "properties": {
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "ncloc": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "$ref": "urn:qualis:schema:common:1#/$defs/IssueCounts"
        },
        "ratings": {
          "$ref": "urn:qualis:schema:common:1#/$defs/Ratings"
        },
        "technicalDebtMinutes": {
          "type": "number",
          "minimum": 0
        },
        "debtRatio": {
          "type": "number",
          "minimum": 0
        },
        "duplicatedLines": {
          "type": "integer",
          "minimum": 0
        },
        "duplicatedLinesDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coverage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:qualis:schema:common:1#/$defs/CoverageMeasures"
            }
          ]
        }
      }
    },
    "FileReport": {
      "type": "object",
      "required": [
        "path",
        "language",
        "plugin",
        "measures",
        "functions"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "measures": {
          "type": "object",
          "required": [
            "lines",
            "ncloc",
            "commentLines",
            "functions",
            "classes",
            "statements",
            "complexity",
            "cognitiveComplexity",
            "issues",
            "duplicatedLines",
            "technicalDebtMinutes",
            "halstead",
            "maintainabilityIndex"
          ],
          "properties": {
            "lines": {
              "type": "integer",
              "minimum": 0
            },
            "ncloc": {
              "type": "integer",
              "minimum": 0
            },
            "commentLines": {
              "type": "integer",
              "minimum": 0
            },
            "functions": {
              "type": "integer",
              "minimum": 0
            },
            "classes": {
              "type": "integer",
              "minimum": 0
            },
            "statements": {
              "type": "integer",
              "minimum": 0
            },
            "complexity": {
              "type": "integer",
              "minimum": 0
            },
            "cognitiveComplexity": {
              "type": "integer",
              "minimum": 0
            },
            "issues": {
              "type": "integer",
              "minimum": 0
            },
            "duplicatedLines": {
              "type": "integer",
              "minimum": 0
            },
            "technicalDebtMinutes": {
              "type": "number",
              "minimum": 0
            },
            "halstead": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "urn:qualis:schema:common:1#/$defs/HalsteadMeasures"
                }
              ]
            },
            "maintainabilityIndex": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "newLines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "coverage": {
          "type": "object",
          "required": [
            "coveredLines",
            "uncoveredLines",
            "partialLines"
          ],
          "properties": {
            "coveredLines": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "uncoveredLines": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "partialLines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "line",
                  "covered",
                  "total"
                ],
                "properties": {
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "covered": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "notInReports": {
              "type": "boolean"
            }
          }
        },
        "source": {
          "type": "string"
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "urn:qualis:schema:common:1#/$defs/FunctionReport"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "test": {
          "type": "boolean",
          "description": "True for test code (`tests.sources`)."
        }
      }
    },
    "Issue": {
      "type": "object",
      "required": [
        "id",
        "ruleId",
        "type",
        "characteristic",
        "severity",
        "message",
        "path",
        "range",
        "effortMinutes",
        "tags",
        "isNew"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ruleId": {
          "type": "string"
        },
        "type": {
          "$ref": "urn:qualis:schema:common:1#/$defs/IssueType"
        },
        "characteristic": {
          "$ref": "urn:qualis:schema:common:1#/$defs/Characteristic"
        },
        "severity": {
          "$ref": "urn:qualis:schema:common:1#/$defs/Severity"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "range": {
          "$ref": "urn:qualis:schema:common:1#/$defs/TextRange"
        },
        "secondaryLocations": {
          "type": "array",
          "items": {
            "$ref": "urn:qualis:schema:common:1#/$defs/SecondaryLocation"
          }
        },
        "effortMinutes": {
          "type": "number",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isNew": {
          "type": "boolean"
        }
      }
    }
  }
}
