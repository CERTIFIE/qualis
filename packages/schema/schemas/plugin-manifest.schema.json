{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qualis:schema:plugin-manifest:1",
  "title": "Qualis language plugin manifest",
  "description": "Identity, languages and rules of a language plugin. Returned by the `initialize` request of the stdio protocol, or exposed as properties of an in-process plugin.",
  "type": "object",
  "required": [
    "apiVersion",
    "id",
    "name",
    "version",
    "languages",
    "rules"
  ],
  "properties": {
    "apiVersion": {
      "const": 1
    },
    "kind": {
      "$ref": "urn:qualis:schema:common:1#/$defs/PluginKind"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:qualis:schema:common:1#/$defs/LanguageDescriptor"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "urn:qualis:schema:common:1#/$defs/RuleDefinition"
      }
    }
  }
}
